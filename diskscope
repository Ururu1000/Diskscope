        text.append(lbl)
        sub = Gtk.Label(label=subtitle, xalign=0,
                        ellipsize=Pango.EllipsizeMode.MIDDLE)
        sub.add_css_class("caption")
        sub.add_css_class("dim-label")
        text.append(sub)
        top.append(text)
        box.append(top)
        if mount:
            frac = mount["used"] / mount["total"]
            bar = Gtk.ProgressBar(fraction=frac)
            bar.add_css_class("usage-bar")
            if frac >= 0.95:
                bar.add_css_class("usage-crit")
            elif frac >= 0.85:
                bar.add_css_class("usage-high")
            box.append(bar)
            info = Gtk.Label(
                label=f'{fmt_size(mount["free"])} free of '
                      f'{fmt_size(mount["total"])}', xalign=0)
            info.add_css_class("caption")
            info.add_css_class("numeric")
            box.append(info)
        row.set_child(box)
        return row

    # ---- scanning -------------------------------------------------------------

    def start_scan(self, path):
        if self.busy:
            return
        if self.scanner:
            self.scanner.cancel()
        self.clear_selection()
        self.scan_title.set_label(f"Scanning {display(path)}")
        self.scan_counts.set_label("Starting…")
        self.scan_path.set_label("")
        self.main_stack.set_visible_child_name("scanning")
        self._sync_chrome()
        self.scanner = Scanner(path, self.one_fs, self._on_scan_progress,
                               self._on_scan_done)
        self.scanner.start()

    def cancel_scan(self):
        if self.scanner:
            self.scanner.cancel()
            self.scanner = None
        self.main_stack.set_visible_child_name(
            "results" if self.root else "empty")
        self._sync_chrome()

    def rescan(self):
        if self.root:
            path = self.current.path() if self.current else self.root.path()
            self._rescan_target = path
            self.start_scan(self.root.path())

    def _on_scan_progress(self, scanner, files, dirs, path):
        if scanner is self.scanner:
            self.scan_counts.set_label(f"{files:,} files · {dirs:,} folders")
            self.scan_path.set_label(display(path))
        return False

    def _on_scan_done(self, scanner, result, error):
        if scanner is not self.scanner:
            return False
        self.scanner = None
        if error:
            self.toast(f"Could not scan: {error}")
            self.main_stack.set_visible_child_name(
                "results" if self.root else "empty")
            self._sync_chrome()
            return False
        if result is None:  # cancelled
            return False

        self.root = result["root"]
        self.largest = result["largest"]
        self.link_groups = result["links"]
        target = self._rescan_target
        self._rescan_target = None
        self.current = self._find(target) if target else self.root
        self.main_stack.set_visible_child_name("results")
        self.view_stack.set_visible_child_name("folders")
        self.refresh_views()

        msg = (f'Scanned {result["files"]:,} files in '
               f'{result["elapsed"]:.1f} s')
        if result["errors"]:
            msg += f' · {result["errors"]:,} items unreadable'
        self.toast(msg)
        return False

    def _find(self, path):
        """Locate the node for path in the current tree (falls back to root)."""
        rel = os.path.relpath(path, self.root.path())
        node = self.root
        if rel == ".":
            return node
        for part in rel.split(os.sep):
            nxt = next((c for c in node.children or () if c.name == part), None)
            if nxt is None or not nxt.is_dir:
                break
            node = nxt
        return node

    def _on_one_fs(self, action, value):
        action.set_state(value)
        self.one_fs = value.get_boolean()

    # ---- views ------------------------------------------------------------------

    def refresh_views(self):
        self._fill_folder()
        self._fill_largest()
        self._fill_crumbs()
        self._sync_chrome()

    def _sync_chrome(self):
        results = self.main_stack.get_visible_child_name() == "results"
        folders = self.view_stack.get_visible_child_name() == "folders"
        self.title_stack.set_visible_child_name(
            "switcher" if results else "plain")
        self.crumb_bar.set_visible(results and folders)
        self.act_up.set_enabled(bool(results and folders and self.current
                                     and self.current.parent))
        self.act_rescan.set_enabled(self.root is not None and not self.busy)

    def _keep_scroll(self, scroller, fill):
        adj = scroller.get_vadjustment()
        value = adj.get_value()
        fill()
        GLib.idle_add(lambda: adj.set_value(value) and False)

    def _fill_folder(self, keep_scroll=False):
        def fill():
            d = self.current
            self.folder_list.remove_all()
            self.dir_title.set_label(d.label())
            sub = f"{display(d.path())} · {d.count:,} files"
            if d.parent is not None and self.root.size:
                sub += f" · {d.size / self.root.size * 100:.1f} % of scan"
            self.dir_sub.set_label(sub)
            self.dir_size.set_label(fmt_size(d.size))

            kids = d.children or []
            if not kids:
                empty = Adw.ActionRow(
                    title="This folder is empty" if d.note is None
                    else "Contents could not be read",
                    activatable=False)
                self.folder_list.append(empty)
                return
            for child in kids[:MAX_ROWS]:
                self.folder_list.append(NodeRow(self, child, d.size, False))
            rest = kids[MAX_ROWS:]
            if rest:
                self.folder_list.append(Adw.ActionRow(
                    title=f"… and {len(rest):,} smaller items",
                    subtitle=fmt_size(sum(n.size for n in rest)) + " in total",
                    activatable=False))

        if keep_scroll:
            self._keep_scroll(self.folder_scroll, fill)
        else:
            fill()
            self.folder_scroll.get_vadjustment().set_value(0)

    def _fill_largest(self, keep_scroll=False):
        def fill():
            self.largest_list.remove_all()
            self.largest = [n for n in self.largest if self.alive(n)]
            if not self.largest:
                self.largest_list.append(Adw.ActionRow(
                    title="No files found", activatable=False))
                return
            for n in self.largest:
                self.largest_list.append(
                    NodeRow(self, n, self.root.size, True))

        if keep_scroll:
            self._keep_scroll(self.largest_scroll, fill)
        else:
            fill()

    def _fill_crumbs(self):
        child = self.crumbs.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.crumbs.remove(child)
            child = nxt
        chain = [self.current] + list(ancestors(self.current))
        chain.reverse()
        for i, node in enumerate(chain):
            last = i == len(chain) - 1
            label = display(node.name) if node.parent is None else node.label()
            if i:
                sep = Gtk.Label(label="›")
                sep.add_css_class("crumb-sep")
                self.crumbs.append(sep)
            btn = Gtk.Button(label=label, sensitive=not last)
            btn.add_css_class("flat")
            btn.add_css_class("crumb")
            if last:
                btn.add_css_class("heading")
            btn.connect("clicked", lambda _b, n=node: self.navigate(n))
            self.crumbs.append(btn)
        GLib.idle_add(self._scroll_crumbs_end)

    def _scroll_crumbs_end(self):
        adj = self.crumb_bar.get_hadjustment()
        adj.set_value(adj.get_upper())
        return False

    def navigate(self, node):
        self.current = node
        self._fill_folder()
        self._fill_crumbs()
        self._sync_chrome()

    def go_up(self):
        if self.current and self.current.parent:
            prev = self.current
            self.navigate(self.current.parent)
            for row in self._rows(self.folder_list):
                if row.node is prev:
                    row.grab_focus()
                    break

    def _on_folder_row(self, _lb, row):
        n = getattr(row, "node", None)
        if n is None or not n.is_dir:
            return
        if n.note == "mount":
            self.start_scan(n.path())
        elif n.note is None:
            self.navigate(n)

    def _on_largest_row(self, _lb, row):
        n = getattr(row, "node", None)
        if n is None or n.parent is None:
            return
        self.view_stack.set_visible_child_name("folders")
        self.navigate(n.parent)
        for r in self._rows(self.folder_list):
            if r.node is n:
                r.grab_focus()
                break

    @staticmethod
    def _rows(listbox):
        row = listbox.get_first_child()
        while row:
            if isinstance(row, NodeRow):
                yield row
            row = row.get_next_sibling()

    # ---- selection ----------------------------------------------------------------

    def set_selected(self, node, on):
        if on:
            self.selection.add(node)
        else:
            self.selection.discard(node)
        self._sync_selection()

    def clear_selection(self):
        self.selection.clear()
        for lb in (self.folder_list, self.largest_list):
            for row in self._rows(lb):
                row.check.set_active(False)
        self._sync_selection()

    def _sync_selection(self):
        sel = self._prune(self.selection)
        if sel:
            total = sum(n.size for n in sel)
            self.sel_label.set_label(
                f"{len(sel):,} selected · {fmt_size(total)}")
        self.action_bar.set_revealed(bool(sel))

    def _prune(self, nodes):
        """Drop dead nodes and nodes whose ancestor is also in the set."""
        nodes = {n for n in nodes if self.alive(n)}
        return [n for n in nodes if not any(a in nodes for a in ancestors(n))]

    def alive(self, node):
        n = node
        while n.parent is not None:
            if n.deleted:
                return False
            n = n.parent
        return n is self.root

    # ---- deletion ---------------------------------------------------------------------

    def delete_shortcut(self):
        if self.main_stack.get_visible_child_name() != "results":
            return
        if self.selection:
            self.request_delete(list(self.selection))
            return
        w = self.get_focus()
        while w is not None and not isinstance(w, NodeRow):
            w = w.get_parent()
        if w is not None:
            self.request_delete([w.node])

    def request_delete(self, nodes):
        if self.busy:
            return
        nodes = self._prune(nodes)
        if not nodes:
            return
        for n in nodes:
            if n.parent is None or is_protected(n.path()):
                self.toast(f"“{display(n.path())}” is a protected location "
                           "and can't be deleted from here")
                return
        nodes.sort(key=lambda n: n.size, reverse=True)
        total = sum(n.size for n in nodes)

        if len(nodes) == 1:
            n = nodes[0]
            kind = "Folder" if n.is_dir else "File"
            heading = f"Delete {kind}?"
            body = f"{display(n.path())}\n\n{fmt_size(n.size)}"
            if n.is_dir:
                body += f" · {n.count:,} files"
        else:
            heading = f"Delete {len(nodes)} Items?"
            shown = "\n".join(f"• {n.label()}  ({fmt_size(n.size)})"
                              for n in nodes[:8])
            if len(nodes) > 8:
                shown += f"\n• … and {len(nodes) - 8} more"
            body = f"{shown}\n\nTotal: {fmt_size(total)}"
        body += ("\n\nMove to Trash lets you restore later. "
                 "Delete Permanently cannot be undone.")

        dlg = Adw.AlertDialog(heading=heading, body=body)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("trash", "Move to Trash")
        dlg.add_response("delete", "Delete Permanently")
        dlg.set_response_appearance("trash", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_response_appearance("delete",
                                    Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_default_response("trash")
        dlg.set_close_response("cancel")
        dlg.connect("response", self._on_delete_response, nodes)
        dlg.present(self)

    def _on_delete_response(self, _dlg, response, nodes):
        if response not in ("trash", "delete"):
            return
        permanent = response == "delete"
        items = [(n, n.path()) for n in nodes]
        self.busy = True
        self.main_stack.set_sensitive(False)
        self._sync_chrome()
        verb = "Deleting" if permanent else "Moving to Trash"
        self._busy_toast = Adw.Toast(title=f"{verb} {len(items)} item(s)…",
                                     timeout=0)
        self.toasts.add_toast(self._busy_toast)
        threading.Thread(target=self._delete_worker,
                         args=(items, permanent), daemon=True).start()

    def _delete_worker(self, items, permanent):
        results = []
        for node, path in items:
            try:
                if permanent:
                    if os.path.isdir(path) and not os.path.islink(path):
                        shutil.rmtree(path)
                    else:
                        os.unlink(path)
                else:
                    Gio.File.new_for_path(path).trash(None)
                results.append((node, path, None))
            except GLib.Error as e:
                results.append((node, path, e.message))
            except OSError as e:
                results.append((node, path, e.strerror or str(e)))
        GLib.idle_add(self._on_deleted, results, permanent)

    def _on_deleted(self, results, permanent):
        self.busy = False
        self.main_stack.set_sensitive(True)
        if self._busy_toast:
            self._busy_toast.dismiss()
            self._busy_toast = None

        before = self.root.size
        done = 0
        partial = False
        failures = []
        for node, path, err in results:
            self.selection.discard(node)
            if err is None:
                done += 1
                self._remove_node(node)
            elif os.path.lexists(path):
                failures.append((path, err))
                if node.is_dir:
                    partial = True
            else:  # vanished anyway
                done += 1
                self._remove_node(node)

        self._reassign_links()
        freed = before - self.root.size

        if not self.alive(self.current):
            n = self.current
            while not self.alive(n):
                n = n.parent
            self.current = n

        self._fill_folder(keep_scroll=True)
        self._fill_largest(keep_scroll=True)
        self._fill_crumbs()
        self._sync_selection()
        self._sync_chrome()
        self.refresh_mounts()

        if done:
            where = "Deleted" if permanent else "Moved to Trash:"
            self.toast(f"{where} {done} item(s) · {fmt_size(freed)} "
                       + ("freed" if permanent else "(empty Trash to free it)"))
        if failures:
            path, err = failures[0]
            more = f" (+{len(failures) - 1} more)" if len(failures) > 1 else ""
            msg = f"Couldn't delete {display(os.path.basename(path))}: {err}{more}"
            if partial:
                msg += " — some contents may be gone, rescan to refresh"
            elif not permanent and "not supported" in err:
                msg += " — use Delete Permanently instead"
            self.toast(msg, timeout=8)
        return False

    def _reassign_links(self):
        """Deleting one name of a hard-linked file frees nothing while other
        names remain, so hand the counted size to a surviving link."""
        groups = []
        for group in self.link_groups:
            alive = [n for n in group if self.alive(n)]
            if not alive:
                continue
            if alive[0] is not group[0]:  # the counted name was deleted
                heir = alive[0]
                heir.size = group[0].size
                for a in ancestors(heir):
                    a.size += heir.size
                heir.parent.children.sort(key=lambda n: n.size, reverse=True)
                self.largest.append(heir)
            if len(alive) > 1:
                groups.append(alive)
        self.largest.sort(key=lambda n: n.size, reverse=True)
        del self.largest[TOP_FILES:]
        self.link_groups = groups

    def _remove_node(self, node):
        parent = node.parent
        if parent is None or node.deleted:
            return
        try:
            parent.children.remove(node)
        except ValueError:
            return
        node.deleted = True
        a = parent
        while a is not None:
            a.size -= node.size
            a.count -= node.count
            a = a.parent

    # ---- misc ------------------------------------------------------------------------

    def reveal(self, node):
        launcher = Gtk.FileLauncher(file=Gio.File.new_for_path(node.path()))

        def done(l, res):
            try:
                l.open_containing_folder_finish(res)
            except GLib.Error as e:
                self.toast(f"Couldn't open file manager: {e.message}")

        launcher.open_containing_folder(self, None, done)

    def choose_folder(self):
        dlg = Gtk.FileDialog(title="Choose a Folder to Scan")
        dlg.set_initial_folder(Gio.File.new_for_path(
            self.root.path() if self.root else HOME))

        def done(d, res):
            try:
                f = d.select_folder_finish(res)
            except GLib.Error:
                return
            if f and f.get_path():
                self.start_scan(f.get_path())

        dlg.select_folder(self, None, done)

    def show_about(self):
        Adw.AboutDialog(
            application_name="Diskscope", version=VERSION,
            application_icon="drive-harddisk",
            comments="See what's using your disk space and clean it up.",
            license_type=Gtk.License.MIT_X11).present(self)

    def toast(self, text, timeout=4):
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text),
                                        timeout=timeout))

    def _on_close(self, *_):
        if self.scanner:
            self.scanner.cancel()
        return False


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.add_main_option("version", ord("v"), GLib.OptionFlags.NONE,
                             GLib.OptionArg.NONE, "Show version", None)

    def do_handle_local_options(self, options):
        if options.contains("version"):
            print(f"Diskscope {VERSION}")
            return 0
        return -1

    def do_startup(self):
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        quit_ = Gio.SimpleAction.new("quit", None)
        quit_.connect("activate", lambda *_: self.quit())
        self.add_action(quit_)
        self.set_accels_for_action("app.quit", ["<Ctrl>q"])
        self.set_accels_for_action("win.up", ["<Alt>Up", "BackSpace"])
        self.set_accels_for_action("win.rescan", ["F5", "<Ctrl>r"])
        self.set_accels_for_action("win.open", ["<Ctrl>o"])
        self.set_accels_for_action("win.delete", ["Delete"])

    def _window(self):
        win = self.get_active_window()
        if win is None:
            win = Window(self)
        return win

    def do_activate(self):
        self._window().present()

    def do_open(self, files, _n, _hint):
        win = self._window()
        win.present()
        if files and files[0].get_path():
            win.start_scan(files[0].get_path())


def main():
    return App().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
