class NodeRow(Gtk.ListBoxRow):
    """One file/folder row: checkbox, icon, name, share bar, size, actions."""

    def __init__(self, win, node, ref_size, show_path):
        super().__init__()
        self.node = node
        self.win = win
        if show_path:
            self.set_activatable(True)
        else:
            self.set_activatable(node.is_dir)

        box = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6,
                      margin_start=8, margin_end=6)
        self.set_child(box)

        self.check = Gtk.CheckButton(valign=Gtk.Align.CENTER,
                                     tooltip_text="Select for deletion")
        self.check.set_active(node in win.selection)
        self.check.connect("toggled", self._on_toggled)
        box.append(self.check)

        box.append(Gtk.Image.new_from_gicon(self._icon()))

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True,
                       valign=Gtk.Align.CENTER)
        name = Gtk.Label(label=node.label(), xalign=0,
                         ellipsize=Pango.EllipsizeMode.MIDDLE)
        name.set_tooltip_text(display(node.path()))
        text.append(name)
        sub = Gtk.Label(label=self._subtitle(show_path), xalign=0,
                        ellipsize=Pango.EllipsizeMode.START)
        sub.add_css_class("dim-label")
        sub.add_css_class("caption")
        text.append(sub)
        box.append(text)

        frac = node.size / ref_size if ref_size else 0.0
        bar_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                          valign=Gtk.Align.CENTER)
        bar = Gtk.ProgressBar(fraction=min(frac, 1.0), width_request=130)
        bar.add_css_class("size-bar")
        bar_box.append(bar)
        pct = Gtk.Label(label=f"{frac * 100:.1f} %", xalign=1)
        pct.add_css_class("caption")
        pct.add_css_class("dim-label")
        pct.add_css_class("numeric")
        bar_box.append(pct)
        box.append(bar_box)

        size = Gtk.Label(label=fmt_size(node.size), xalign=1, width_chars=10)
        size.add_css_class("numeric")
        size.add_css_class("heading")
        box.append(size)

        reveal = Gtk.Button(icon_name="folder-open-symbolic",
                            valign=Gtk.Align.CENTER,
                            tooltip_text="Show in file manager")
        reveal.add_css_class("flat")
        reveal.connect("clicked", lambda *_: win.reveal(node))
        box.append(reveal)

        delete = Gtk.Button(icon_name="user-trash-symbolic",
                            valign=Gtk.Align.CENTER, tooltip_text="Delete…")
        delete.add_css_class("flat")
        delete.add_css_class("delete-btn")
        delete.connect("clicked", lambda *_: win.request_delete([node]))
        box.append(delete)

    def _icon(self):
        n = self.node
        if n.is_dir:
            if n.note == "denied":
                return Gio.ThemedIcon.new("action-unavailable-symbolic")
            if n.note in ("mount", "virtual"):
                return Gio.ThemedIcon.new("drive-harddisk-symbolic")
            return Gio.ThemedIcon.new("folder-symbolic")
        ctype, _ = Gio.content_type_guess(display(n.name), None)
        return Gio.content_type_get_symbolic_icon(ctype)

    def _subtitle(self, show_path):
        n = self.node
        if show_path:
            return display(n.parent.path()) if n.parent else ""
        if n.is_dir:
            if n.note == "denied":
                return "Permission denied — contents not counted"
            if n.note == "mount":
                return "Separate file system — click to scan it"
            if n.note == "virtual":
                return "System virtual file system — not scanned"
            return f"{n.count:,} file" + ("" if n.count == 1 else "s")
        return "Modified " + time.strftime("%Y-%m-%d %H:%M",
                                           time.localtime(n.mtime))

    def _on_toggled(self, check):
        self.win.set_selected(self.node, check.get_active())


