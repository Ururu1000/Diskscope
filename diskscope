# --------------------------------------------------------------------------
# Helpers
# --------------------------------------------------------------------------

def fmt_size(n):
    n = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PiB"


def display(s):
    """Make a filesystem string safe to show (non-UTF-8 names)."""
    return s.encode("utf-8", "surrogateescape").decode("utf-8", "replace")


def is_protected(path):
    ap = os.path.normpath(os.path.abspath(path))
    if ap in PROTECTED:
        return True
    if not os.path.islink(ap):
        if os.path.realpath(ap) in PROTECTED or os.path.ismount(ap):
            return True
    return False


class Node:
    """A file or directory in the scanned tree."""

    __slots__ = ("name", "parent", "size", "count", "is_dir", "children",
                 "mtime", "note", "deleted")

    def __init__(self, name, parent, is_dir, size=0, mtime=0.0):
        self.name = name          # full path for the root, basename otherwise
        self.parent = parent
        self.size = size          # bytes on disk, including descendants
        self.count = 0 if is_dir else 1   # number of files beneath
        self.is_dir = is_dir
        self.children = [] if is_dir else None
        self.mtime = mtime
        self.note = None          # None | "denied" | "mount" | "virtual"
        self.deleted = False

    def path(self):
        parts = []
        n = self
        while n is not None:
            parts.append(n.name)
            n = n.parent
        return os.path.join(*reversed(parts))

    def label(self):
        if self.parent is None:
            return display(os.path.basename(self.name.rstrip("/")) or "/")
        return display(self.name)


def ancestors(node):
    n = node.parent
    while n is not None:
        yield n
        n = n.parent


# --------------------------------------------------------------------------
# Scanner (runs in a worker thread)
# --------------------------------------------------------------------------

class Scanner:
    def __init__(self, root_path, one_fs, on_progress, on_done):
        self.root_path = os.path.abspath(root_path)
        self.one_fs = one_fs
        self.on_progress = on_progress
        self.on_done = on_done
        self._cancel = threading.Event()
        self.thread = threading.Thread(target=self._run, daemon=True)

    def start(self):
        self.thread.start()

    def cancel(self):
        self._cancel.set()

    @property
    def cancelled(self):
        return self._cancel.is_set()

    def _run(self):
        t0 = time.monotonic()
        try:
            result = self._scan()
        except OSError as e:
            GLib.idle_add(self.on_done, self, None, e.strerror or str(e))
            return
        if result is not None:
            result["elapsed"] = time.monotonic() - t0
        GLib.idle_add(self.on_done, self, result, None)

    def _scan(self):
        st = os.lstat(self.root_path)
        if not stat.S_ISDIR(st.st_mode):
            raise NotADirectoryError(20, "Not a folder", self.root_path)
        root = Node(self.root_path, None, True, st.st_blocks * 512, st.st_mtime)
        root_dev = st.st_dev
        links = {}        # (dev, ino) -> nodes sharing that inode
        top = []          # min-heap of (size, tiebreak, node)
        tiebreak = 0
        dirs = []         # pre-order: every dir comes before its descendants
        stack = [root]
        files = errors = 0
        last = 0.0

        while stack:
            if self._cancel.is_set():
                return None
            d = stack.pop()
            dirs.append(d)
            path = d.path()
            try:
                with os.scandir(path) as it:
                    entries = list(it)
            except OSError:
                d.note = "denied"
                errors += 1
                continue

            for e in entries:
                try:
                    est = e.stat(follow_symlinks=False)
                except OSError:
                    errors += 1
                    continue
                size = est.st_blocks * 512
                if stat.S_ISDIR(est.st_mode):
                    child = Node(e.name, d, True, size, est.st_mtime)
                    d.children.append(child)
                    full = os.path.join(path, e.name)
                    if full in VIRTUAL_DIRS:
                        child.note = "virtual"
                    elif self.one_fs and est.st_dev != root_dev:
                        child.note = "mount"
                    else:
                        stack.append(child)
                        continue
                    d.size += size  # unscanned dir: count only itself
                else:
                    group = None
                    if est.st_nlink > 1:  # count hard-linked data once
                        group = links.setdefault((est.st_dev, est.st_ino), [])
                        if group:
                            size = 0
                    child = Node(e.name, d, False, size, est.st_mtime)
                    if group is not None:
                        group.append(child)
                    d.children.append(child)
                    d.size += size
                    d.count += 1
                    files += 1
                    if size:
                        tiebreak += 1
                        item = (size, tiebreak, child)
                        if len(top) < TOP_FILES:
                            heapq.heappush(top, item)
                        elif size > top[0][0]:
                            heapq.heapreplace(top, item)

            now = time.monotonic()
            if now - last > 0.08:
                last = now
                GLib.idle_add(self.on_progress, self, files, len(dirs), path)

        # Roll sizes up: descendants are visited before their ancestors.
        for d in reversed(dirs):
            if d.parent is not None:
                d.parent.size += d.size
                d.parent.count += d.count
        for d in dirs:
            d.children.sort(key=lambda n: n.size, reverse=True)

        largest = [n for _, _, n in sorted(top, key=lambda t: t[0], reverse=True)]
        return {"root": root, "largest": largest, "files": files,
                "dirs": len(dirs), "errors": errors,
                "links": [g for g in links.values() if len(g) > 1]}


# --------------------------------------------------------------------------
# Mounted file systems
# --------------------------------------------------------------------------

def _unescape_mount(s):
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), s)


def list_mounts():
    mounts = []
    seen = set()
    try:
        with open("/proc/self/mounts") as f:
            lines = f.readlines()
    except OSError:
        return mounts
    for line in lines:
        parts = line.split()
        if len(parts) < 3:
            continue
        dev, mnt, fstype = parts[0], _unescape_mount(parts[1]), parts[2]
        if not dev.startswith("/dev/") or dev.startswith("/dev/loop"):
            continue
        if mnt in seen:
            continue
        try:
            sv = os.statvfs(mnt)
        except OSError:
            continue
        total = sv.f_blocks * sv.f_frsize
        if total == 0:
            continue
        seen.add(mnt)
        used = (sv.f_blocks - sv.f_bfree) * sv.f_frsize
        free = sv.f_bavail * sv.f_frsize
        mounts.append({"mount": mnt, "device": dev, "fstype": fstype,
                       "total": total, "used": used, "free": free})
    mounts.sort(key=lambda m: (m["mount"] != "/", m["mount"]))
    return mounts


