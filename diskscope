# Never deleted from the UI, no matter what.
PROTECTED = {
    "/", "/bin", "/boot", "/dev", "/efi", "/etc", "/home", "/lib", "/lib32",
    "/lib64", "/media", "/mnt", "/opt", "/proc", "/root", "/run", "/sbin",
    "/srv", "/sys", "/tmp", "/usr", "/var", "/usr/bin", "/usr/lib",
    "/usr/lib32", "/usr/lib64", "/usr/local", "/usr/sbin", "/usr/share",
    "/var/lib", "/var/log", "/var/cache", HOME,
    os.path.join(HOME, ".config"), os.path.join(HOME, ".local"),
    os.path.join(HOME, ".local/share"),
}

# Kernel/virtual trees that are never scanned, even with "one file system" off.
VIRTUAL_DIRS = {"/proc", "/sys", "/dev", "/run"}

